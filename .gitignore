# 导出的坐标、工程、草稿文件（运行时生成）
coordinates_*.json
coordinate_project_*.json
draft_*.json
structures_final.json

# 模型压缩中间文件
*.tmp1.glb

# 示例项目的大体积 GLB 模型（103MB 原始 + 4.6MB 压缩版），用户自带或现场生成，不进库
app/examples/ljw/model*.glb

# 本地服务器与工具噪声
.DS_Store
Thumbs.db
*.log
__pycache__/
*.pyc

# 若后续扩展为 Node 项目时的依赖/构建目录
node_modules/
dist/
# PyInstaller 构建中间产物
build/

# PyInstaller 打包产物（只提交 build.spec 源，不提交生成的 exe）
*.spec.bak
CoordinateCollector.exe

# 临时验证脚本
_verify*.mjs

# 内部文档与开发状态（不纳入版本控制，避免设计文档/内部资料/开发计划泄漏）
docs/
*.legacy.md
*.legacy.txt

# 密钥与环境变量（绝不提交，防止泄露）
.env
.env.*
*.pem
*.key
secrets.json

# 编辑器/IDE/开发工具配置目录（不上传，避免泄露本地配置与私密信息）
.idea/
.vscode/
.zcode/
.agents/
.data/
*.swp
*.swo
*~
